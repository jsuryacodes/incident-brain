FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FalkorDB Cloud / secured instances only
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=0
# Tenants (one FalkorDB graph each)
TENANTS=kestrel_pay,northwind_health,scale_demo
# LLM: mock (free, default) or live. Live needs a key. Never commit .env.
LLM_MODE=mock
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
MAX_RUN_COST_USD=0.05
# API protection
ACCESS_CODE=
DAILY_LIVE_RUNS=30
RATE_LIMIT_PER_MIN=60
CORS_ORIGINS=http://localhost:5173
# Container: seed empty graphs + play the story once on start (mock). docs/deploy.md
SEED_ON_START=0
PORT=8000
